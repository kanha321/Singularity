<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Singularity Convergence</vendor>
  <vendor_url>https://github.com/kanhaji/singularity</vendor_url>
  <action id="com.kanhaji.singularity.reload-v4l2loopback">
    <description>Reset Singularity Virtual Continuity Camera</description>
    <message>Authentication is required to configure virtual camera</message>
    <icon_name>camera-web</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/singularity/reload-v4l2loopback</annotate>
  </action>
</policyconfig>

